# gstack renders its skills into this directory on every ./setup --team run.
# They are generated artifacts (and the Gstack clone is ~1.3 GB), so they are
# not committed. Only the hand-maintained skills below stay tracked.
/*
!/.gitignore
!/dev-memory/
!/ponytail-skill/
!/requesting-code-review/
!/systematic-debugging/
!/test-driven-development/
!/verification-before-completion/
