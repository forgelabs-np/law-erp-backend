<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.lawfirm.erp.rbac.mapper.ModuleMapper">

    <!-- Simple Result Map without any associations -->
    <resultMap id="ModuleResultMap" type="com.lawfirm.erp.dto.admin.response.ModuleResponse">
        <id property="id" column="id"/>
        <result property="name" column="name"/>
        <result property="code" column="code"/>
        <result property="description" column="description"/>
        <result property="level" column="level"/>
        <result property="displayOrder" column="display_order"/>
        <result property="icon" column="icon"/>
        <result property="path" column="path"/>
        <result property="parentId" column="parent_id"/>
        <result property="isSystem" column="is_system"/>
        <result property="isActive" column="is_active"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <!-- Get all modules -->
    <select id="findAllModules" resultMap="ModuleResultMap">
        SELECT
            id,
            name,
            code,
            description,
            level,
            display_order,
            icon,
            path,
            parent_id,
            is_system,
            is_active,
            created_at,
            updated_at
        FROM modules
        ORDER BY level ASC, display_order ASC
    </select>

    <!-- Get active modules -->
    <select id="findAllActiveModules" resultMap="ModuleResultMap">
        SELECT
            id,
            name,
            code,
            description,
            level,
            display_order,
            icon,
            path,
            parent_id,
            is_system,
            is_active,
            created_at,
            updated_at
        FROM modules
        WHERE is_active = true
        ORDER BY level ASC, display_order ASC
    </select>

    <!-- Get module by ID -->
    <select id="findModuleById" resultMap="ModuleResultMap">
        SELECT
            id,
            name,
            code,
            description,
            level,
            display_order,
            icon,
            path,
            parent_id,
            is_system,
            is_active,
            created_at,
            updated_at
        FROM modules
        WHERE id = #{moduleId}
    </select>

    <!-- Get sub-modules by parent ID -->
    <select id="findSubModulesByParentId" resultMap="ModuleResultMap">
        SELECT
            id,
            name,
            code,
            description,
            level,
            display_order,
            icon,
            path,
            parent_id,
            is_system,
            is_active,
            created_at,
            updated_at
        FROM modules
        WHERE parent_id = #{id}
        ORDER BY display_order ASC
    </select>

    <!-- Get flat list -->
    <select id="findAllModulesFlat" resultMap="ModuleResultMap">
        SELECT
            id,
            name,
            code,
            description,
            level,
            display_order,
            icon,
            path,
            parent_id,
            is_system,
            is_active,
            created_at,
            updated_at
        FROM modules
        ORDER BY level ASC, display_order ASC
    </select>

    <!-- Count permissions by module ID -->
    <select id="countPermissionsByModuleId" resultType="int">
        SELECT COUNT(*)
        FROM permissions
        WHERE module_id = #{moduleId}
    </select>

</mapper>