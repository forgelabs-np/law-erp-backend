[TEMPLATE]
# Database
DB_URL=jdbc:postgresql://localhost:5432/postgres
DB_USERNAME=postgres
DB_PASSWORD=change-me

# JWT (min 64 chars for HS512)
JWT_SECRET=change-me-generate-with-openssl-rand-base64-64

# Super Admin Registration (min 32 chars, random hex)
SUPER_ADMIN_REGISTRATION_SECRET=change-me-generate-with-openssl-rand-hex-16

# Config Encryption (AES-256, base64-encoded 32 bytes)
# Generate with: openssl rand -base64 32
CONFIG_ENCRYPTION_KEY=change-me-generate-with-openssl-rand-base64-32

# CORS (comma-separated origins, e.g. http://localhost:5173,https://app.example.com)
# Leave empty for default localhost dev origins
CORS_ALLOWED_ORIGINS=

# Document storage (MinIO / S3-compatible)
# MINIO_ENDPOINT MUST be reachable from the BROWSER — uploads and downloads go directly to
# storage using presigned URLs, never through this application. A browser-unreachable
# endpoint (e.g. http://minio:9000 from inside the cluster) breaks uploads at runtime.
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change-me-min-8-chars
MINIO_BUCKET=tarikh-documents
MINIO_REGION=us-east-1

# Storage allocated to a firm that has no explicit quota, in bytes (default 5 GB).
# Per-firm allocations are set by the Super Admin and stored in the database.
DEFAULT_STORAGE_QUOTA_BYTES=5368709120
