# Database
DB_URL=jdbc:postgresql://localhost:5432/postgres
DB_USERNAME=postgres
DB_PASSWORD=change-me

# JWT (min 64 chars for HS512)
JWT_SECRET=change-me-generate-with-openssl-rand-base64-64

# Super Admin Registration (min 32 chars, random hex)
SUPER_ADMIN_REGISTRATION_SECRET=change-me-generate-with-openssl-rand-hex-16

# Config Encryption (AES-256, base64-encoded 32 bytes)
# Generate with: openssl rand -base64 32
CONFIG_ENCRYPTION_KEY=change-me-generate-with-openssl-rand-base64-32

# CORS (comma-separated origins, e.g. http://localhost:5173,https://app.example.com)
# Leave empty for default localhost dev origins
CORS_ALLOWED_ORIGINS=
